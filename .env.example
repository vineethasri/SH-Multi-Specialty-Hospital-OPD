# ASP.NET Core Connection String
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=sh_hospital_opd;User=hospital_app;Password=ChangeMe_AppPass_2026!;SslMode=Preferred;

# JWT Configuration (Use at least 32+ random characters in production)
Jwt__Issuer=SHHospitalOPD.API
Jwt__Audience=SHHospitalOPD.Client
Jwt__SecretKey=SH_Hospital_OPD_Super_Secret_Signing_Key_2026_Change_In_Prod!
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ASP.NET Core Environment & URLs
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7001;http://localhost:5001

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=https://localhost:4200

# Demo Seed Toggle (Set false in Production)
Seed__EnableDemoData=true

